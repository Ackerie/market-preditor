{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "pnpm install",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Start API Server",
      "type": "shell",
      "command": "PORT=8080 BASE_PATH=/api pnpm --filter @workspace/api-server run dev",
      "group": "none",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*build.*$",
          "endsPattern": "^.*Server listening.*$"
        }
      }
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "PORT=5173 BASE_PATH=/ pnpm --filter @workspace/crypto-trader run dev",
      "group": "none",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*vite.*$",
          "endsPattern": "^.*ready in.*$"
        }
      }
    },
    {
      "label": "Start Both Servers",
      "dependsOn": ["Start API Server", "Start Frontend"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Push DB schema",
      "type": "shell",
      "command": "pnpm --filter @workspace/db run push",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run codegen (after OpenAPI changes)",
      "type": "shell",
      "command": "pnpm --filter @workspace/api-spec run codegen && echo '' && echo '  lib/api-zod/src/index.ts — replace contents with: export * from \"./generated/api\";' && echo ''",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run API tests",
      "type": "shell",
      "command": "pnpm --filter @workspace/api-server run test",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Typecheck (full)",
      "type": "shell",
      "command": "pnpm run typecheck",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
