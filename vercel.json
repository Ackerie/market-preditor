{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "artifacts/crypto-trader/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://workspaceapi-server-production-f1e3.up.railway.app/api/:path*"
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/delete-account",
      "destination": "/account-deletion.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
